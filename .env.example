# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#                         python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- deployment ---
SITE_ADDRESS=tenders.example.com
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-random-48-char-string
FERNET_KEY=
DASHBOARD_BASE_URL=https://tenders.example.com
CORS_ORIGINS=https://tenders.example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- LLM (leave the key empty to run in rules-only mode) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_FALLBACKS_ENABLED=true

# --- commercial value rules ---
SERVICE_MAX_VALUE_INR=3000000
SERVICE_VALUE_RULE_ENABLED=true
# MANUAL_REVIEW | ACCEPT | REJECT
SERVICE_UNKNOWN_VALUE_ACTION=MANUAL_REVIEW
OEM_VALUE_LIMIT_ENABLED=false
OEM_MAX_VALUE_INR=0
HYBRID_REVIEW_ENABLED=true
# MANUAL_REVIEW | ACCEPT | REJECT
HYBRID_SERVICE_OVER_CAP_ACTION=MANUAL_REVIEW

# --- relevance / scoring ---
MIN_RELEVANCE_SCORE=40
HOT_SCORE_THRESHOLD=90
HIGH_SCORE_THRESHOLD=75
MEDIUM_SCORE_THRESHOLD=60
# MANUAL_REVIEW | SUPPRESS
ADJACENT_MATCH_ACTION=MANUAL_REVIEW
STRONG_MATCH_MIN_CONFIDENCE=70
WEIGHT_CAPABILITY=30
WEIGHT_TECHNICAL=20
WEIGHT_OEM=20
WEIGHT_COMMERCIAL=10
WEIGHT_ELIGIBILITY=10
WEIGHT_TIMELINE=5
WEIGHT_STRATEGIC=5

# --- discovery ---
DEFAULT_DISCOVERY_INTERVAL_MINUTES=45
DISCOVERY_MAX_PAGES=30
PORTAL_REQUEST_DELAY_SECONDS=2.0
HTTP_USER_AGENT=TenderIntelBot/1.0 (+mailto:security-sales@example.com)

# --- documents ---
OCR_ENABLED=true
CLAMAV_HOST=

# --- email alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_FROM=tender-alerts@example.com
ALERT_RECIPIENTS=bids@example.com
# immediate | digest
HIGH_ALERT_MODE=immediate
ALERT_ON_MANUAL_REVIEW=true
DIGEST_HOUR_IST=9
